    <rect x="40" y="70" width="100" height="100" rx="4" fill="#0a0a0a" opacity="0.6"/>
    <circle cx="90" cy="195" r="8" fill="#dc2626"/>
    <circle cx="90" cy="215" r="8" fill="#ef4444" opacity="0.6"/>
    <rect x="200" y="40" width="160" height="15" rx="4" fill="#dc2626" opacity="0.8"/>
    <rect x="200" y="75" width="140" height="8" rx="2" fill="#ef4444" opacity="0.4"/>
    <rect x="200" y="95" width="100" height="8" rx="2" fill="#ef4444" opacity="0.4"/>
