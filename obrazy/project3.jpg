<svg width="800" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#111111;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0a0a0a;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="redGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#dc2626;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#991b1b;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgGrad)"/>
  <circle cx="600" cy="150" r="80" fill="#dc2626" opacity="0.1"/>
  <circle cx="250" cy="350" r="100" fill="#dc2626" opacity="0.08"/>
  <g transform="translate(80, 80)">
    <rect x="0" y="0" width="640" height="340" rx="10" fill="#1a1a1a" stroke="#dc2626" stroke-width="2" opacity="0.95"/>
    <rect x="0" y="0" width="640" height="50" rx="10" fill="url(#redGrad)" opacity="0.3"/>
    <circle cx="25" cy="25" r="8" fill="#dc2626"/>
    <circle cx="50" cy="25" r="8" fill="#ef4444" opacity="0.6"/>
    <circle cx="75" cy="25" r="8" fill="#ef4444" opacity="0.4"/>
    <text x="320" y="30" font-family="Inter, sans-serif" font-size="16" fill="#ffffff" text-anchor="middle" font-weight="600">PORTFOLIO</text>
    <g transform="translate(40, 100)">
      <rect x="0" y="0" width="240" height="200" rx="8" fill="#0a0a0a" stroke="#ef4444" stroke-width="1" opacity="0.7"/>
      <rect x="20" y="20" width="200" height="120" rx="4" fill="#dc2626" opacity="0.2"/>
      <rect x="20" y="155" width="100" height="10" rx="2" fill="#ef4444" opacity="0.5"/>
      <rect x="20" y="175" width="80" height="8" rx="2" fill="#ef4444" opacity="0.3"/>
    </g>
    <g transform="translate(320, 100)">
      <rect x="0" y="0" width="240" height="200" rx="8" fill="#0a0a0a" stroke="#ef4444" stroke-width="1" opacity="0.7"/>
      <rect x="20" y="20" width="200" height="120" rx="4" fill="#dc2626" opacity="0.2"/>
      <rect x="20" y="155" width="120" height="10" rx="2" fill="#ef4444" opacity="0.5"/>
      <rect x="20" y="175" width="90" height="8" rx="2" fill="#ef4444" opacity="0.3"/>
    </g>
  </g>
  <text x="400" y="480" font-family="Inter, sans-serif" font-size="24" fill="#dc2626" text-anchor="middle" font-weight="600">Creative Portfolio</text>
</svg>
