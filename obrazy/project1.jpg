<svg width="800" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#111111;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#dc2626;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#991b1b;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#grad1)"/>
  <circle cx="400" cy="250" r="120" fill="url(#grad2)" opacity="0.2"/>
  <g transform="translate(100, 150)">
    <rect x="0" y="0" width="200" height="20" rx="4" fill="#dc2626" opacity="0.8"/>
    <rect x="0" y="35" width="140" height="12" rx="3" fill="#ef4444" opacity="0.4"/>
    <rect x="0" y="55" width="180" height="12" rx="3" fill="#ef4444" opacity="0.4"/>
    <rect x="0" y="75" width="160" height="12" rx="3" fill="#ef4444" opacity="0.4"/>
    <circle cx="30" cy="140" r="15" fill="#dc2626" opacity="0.6"/>
    <circle cx="70" cy="140" r="15" fill="#dc2626" opacity="0.6"/>
    <circle cx="110" cy="140" r="15" fill="#dc2626" opacity="0.6"/>
  </g>
  <g transform="translate(400, 150)">
    <rect x="0" y="0" width="280" height="180" rx="8" fill="#1a1a1a" stroke="#dc2626" stroke-width="2" opacity="0.8"/>
    <rect x="20" y="20" width="240" height="10" rx="3" fill="#ef4444" opacity="0.4"/>
    <rect x="20" y="45" width="200" height="8" rx="2" fill="#ef4444" opacity="0.3"/>
    <rect x="20" y="60" width="220" height="8" rx="2" fill="#ef4444" opacity="0.3"/>
    <rect x="20" y="75" width="180" height="8" rx="2" fill="#ef4444" opacity="0.3"/>
    <rect x="20" y="110" width="80" height="30" rx="4" fill="#dc2626" opacity="0.7"/>
    <rect x="110" y="110" width="80" height="30" rx="4" fill="#dc2626" opacity="0.7"/>
  </g>
  <text x="400" y="480" font-family="Inter, sans-serif" font-size="24" fill="#dc2626" text-anchor="middle" font-weight="600">Modern Web Application</text>
</svg>
